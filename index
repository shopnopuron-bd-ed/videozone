    <!-- Main Script -->
    <script>
        const defaultCategories = ["education", "entertainment", "animation"];
        const defaultVideos = [
            {
                id: "demo-1",
                title: "গণিত বেসিক টিউটোরিয়াল - অধ্যায় ১",
                description: "স্কুল ও ভর্তি পরীক্ষার জন্য গুরুত্বপূর্ণ গণিত বেসিক ক্লাস।",
                category: "education",
                thumbnail: "https://images.unsplash.com/photo-1509228468518-180dd4864904?w=500&auto=format&fit=crop&q=60",
                duration: "1:44:00",
                driveId: "1B2M2Y8AsgT...", 
                url: "https://www.w3schools.com/html/mov_bbb.mp4",
                status: "published",
                featured: true,
                trending: false,
                isDemo: true,
                date: "2026-10-18"
            },
            {
                id: "demo-2",
                title: "মজাদার অ্যানিমেশন শর্ট ফিল্ম",
                description: "শিশু ও সবার জন্য একটি সুন্দর অ্যানিমেশন ভিডিও ক্লিপ।",
                category: "animation",
                thumbnail: "https://images.unsplash.com/photo-1626814026160-2237a95fc5a0?w=500&auto=format&fit=crop&q=60",
                duration: "1:54:00",
                driveId: "",
                url: "https://www.w3schools.com/html/mov_bbb.mp4",
                status: "published",
                featured: false,
                trending: true,
                isDemo: true,
                date: "2026-10-17"
            }
        ];

        let currentCategory = 'all';

        function getCategories() {
            let stored = localStorage.getItem('videozone_categories');
            if (!stored) {
                localStorage.setItem('videozone_categories', JSON.stringify(defaultCategories));
                return defaultCategories;
            }
            return JSON.parse(stored);
        }

        function saveCategories(cats) {
            localStorage.setItem('videozone_categories', JSON.stringify(cats));
        }

        function getVideos() {
            let stored = localStorage.getItem('videozone_videos');
            if (!stored) {
                localStorage.setItem('videozone_videos', JSON.stringify(defaultVideos));
                return defaultVideos;
            }
            return JSON.parse(stored);
        }

        function saveVideos(videos) {
            localStorage.setItem('videozone_videos', JSON.stringify(videos));
        }

        // Render Category Filter Buttons (Right-to-Left)
        function renderCategories() {
            const container = document.getElementById('categoryFilters');
            const selectEl = document.getElementById('vCategorySelect');
            const cats = getCategories();

            container.innerHTML = `<button onclick="filterCategory('all')" class="cat-btn ${currentCategory === 'all' ? 'bg-accent text-white' : 'bg-cardBg text-slate-300'} px-4 py-2 rounded-xl text-sm font-medium whitespace-nowrap transition">সব</button>`;
            selectEl.innerHTML = '';

            cats.forEach(cat => {
                let isActive = currentCategory.toLowerCase() === cat.toLowerCase();
                container.innerHTML += `<button onclick="filterCategory('${cat}')" class="cat-btn ${isActive ? 'bg-accent text-white' : 'bg-cardBg hover:bg-slate-700 text-slate-300'} px-4 py-2 rounded-xl text-sm font-medium whitespace-nowrap transition capitalize">${cat}</button>`;
                selectEl.innerHTML += `<option value="${cat}">${cat}</option>`;
            });
        }

        function checkAndExtractDuration(video, cardElement) {
            if (video.url && video.url.endsWith('.mp4')) {
                const tempVid = document.createElement('video');
                tempVid.src = video.url;
                tempVid.onloadedmetadata = () => {
                    let mins = Math.floor(tempVid.duration / 60);
                    let secs = Math.floor(tempVid.duration % 60);
                    let formatted = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
                    const badge = cardElement.querySelector('.duration-badge');
                    if (badge) badge.innerText = formatted;
                };
            }
        }

        function renderVideos(searchQuery = '') {
            const videos = getVideos();
            const featuredContainer = document.getElementById('featuredContainer');
            const trendingContainer = document.getElementById('trendingContainer');
            const videoContainer = document.getElementById('videoContainer');
            const emptyState = document.getElementById('emptyState');

            featuredContainer.innerHTML = '';
            trendingContainer.innerHTML = '';
            videoContainer.innerHTML = '';

            let filtered = videos.filter(v => v.status === 'published');

            if (currentCategory !== 'all') {
                filtered = filtered.filter(v => v.category.toLowerCase() === currentCategory.toLowerCase());
            }

            if (searchQuery.trim() !== '') {
                let q = searchQuery.toLowerCase();
                filtered = filtered.filter(v => v.title.toLowerCase().includes(q) || v.description.toLowerCase().includes(q) || v.category.toLowerCase().includes(q));
            }

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }

            let featuredList = filtered.filter(v => v.featured);
            let trendingList = filtered.filter(v => v.trending);

            featuredList.forEach(v => featuredContainer.appendChild(createVideoCard(v)));
            trendingList.forEach(v => trendingContainer.appendChild(createVideoCard(v)));
            filtered.forEach(v => videoContainer.appendChild(createVideoCard(v)));
        }

        function createVideoCard(video) {
            const card = document.createElement('div');
            card.className = "bg-cardBg border border-slate-700/60 rounded-xl overflow-hidden hover:border-accent transition flex flex-col group cursor-pointer shadow-lg relative";
            card.onclick = () => { window.location.href = `play.html?id=${video.id}`; };

            const thumbSrc = video.thumbnail ? video.thumbnail : 'https://via.placeholder.com/500x280?text=VideoZone';
            const duration = video.duration || '1:30:00';
            
            card.innerHTML = `
                <div class="relative aspect-video bg-slate-900 overflow-hidden">
                    <img src="${thumbSrc}" alt="${video.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" onerror="this.src='https://via.placeholder.com/500x280?text=No+Image'">
                    <span class="duration-badge absolute top-1.5 right-1.5 bg-black/80 text-white font-semibold text-[10px] px-1.5 py-0.5 rounded">${duration}</span>
                    ${video.isDemo ? '<span class="absolute top-1.5 left-1.5 bg-amber-500/90 text-slate-950 font-bold text-[9px] px-1.5 py-0.5 rounded">ডেমো</span>' : ''}
                    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-2 pt-6">
                        <h3 class="font-bold text-xs sm:text-sm text-white line-clamp-1 drop-shadow-md">${video.title}</h3>
                    </div>
                </div>
            `;
            checkAndExtractDuration(video, card);
            return card;
        }

        function filterCategory(cat) {
            currentCategory = cat;
            renderCategories();
            renderVideos(document.getElementById('searchInput').value);
        }

        // Real-time auto update search listener
        document.getElementById('searchInput').addEventListener('input', (e) => {
            renderVideos(e.target.value);
        });

        // Admin Security Check & Login
        function openAdminLogin() {
            document.getElementById('adminModal').classList.remove('hidden');
            let isAdmin = localStorage.getItem('videozone_admin_logged') === 'true';
            if (isAdmin) {
                showAdminDashboard();
            } else {
                document.getElementById('adminLoginView').classList.remove('hidden');
                document.getElementById('adminDashboardView').classList.add('hidden');
            }
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
        }

        function verifyAdminLogin() {
            const email = document.getElementById('adminEmailInput').value.trim();
            const pass = document.getElementById('adminPasswordInput').value.trim();

            if (email === 'alsamimhossain83@gmail.com' && pass === 'admin123') {
                localStorage.setItem('videozone_admin_logged', 'true');
                showAdminDashboard();
            } else {
                alert('ভুল জিমেইল বা পাসওয়ার্ড! সঠিক জিমেইল (alsamimhossain83@gmail.com) এবং পাসওয়ার্ড দিন।');
            }
        }

        function adminLogout() {
            localStorage.removeItem('videozone_admin_logged');
            document.getElementById('adminLoginView').classList.remove('hidden');
            document.getElementById('adminDashboardView').classList.add('hidden');
            document.getElementById('adminEmailInput').value = '';
            document.getElementById('adminPasswordInput').value = '';
        }

        function showAdminDashboard() {
            document.getElementById('adminLoginView').classList.add('hidden');
            document.getElementById('adminDashboardView').classList.remove('hidden');
            renderAdminVideoList();
            renderAdminCategoryList();
            loadSavedAdsToAdminForm();
        }

        function switchTab(tab) {
            document.getElementById('videoManagerSection').classList.add('hidden');
            document.getElementById('categoriesManagerSection').classList.add('hidden');
            document.getElementById('adsManagerSection').classList.add('hidden');
            document.getElementById('tabVideosBtn').className = "bg-darkBg text-slate-300 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap";
            document.getElementById('tabCategoriesBtn').className = "bg-darkBg text-slate-300 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap";
            document.getElementById('tabAdsBtn').className = "bg-darkBg text-slate-300 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap";

            if (tab === 'videos') {
                document.getElementById('videoManagerSection').classList.remove('hidden');
                document.getElementById('tabVideosBtn').className = "bg-accent text-white px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap";
            } else if (tab === 'categories') {
                document.getElementById('categoriesManagerSection').classList.remove('hidden');
                document.getElementById('tabCategoriesBtn').className = "bg-accent text-white px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap";
            } else if (tab === 'ads') {
                document.getElementById('adsManagerSection').classList.remove('hidden');
                document.getElementById('tabAdsBtn').className = "bg-accent text-white px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap";
            }
        }

        // Category Management Functions
        function addNewCategory() {
            const input = document.getElementById('newCategoryInput');
            const catName = input.value.trim().toLowerCase();
            if (!catName) return;

            let cats = getCategories();
            if (cats.includes(catName)) {
                alert('এই ক্যাটাগরি ইতিমধ্যে রয়েছে!');
                return;
            }

            cats.push(catName);
            saveCategories(cats);
            input.value = '';
            renderAdminCategoryList();
            renderCategories();
            alert('ক্যাটাগরি সফলভাবে যোগ করা হয়েছে!');
        }

        function deleteCategory(catName) {
            if (confirm(`আপনি কি নিশ্চিত '${catName}' ক্যাটাগরি মুছে ফেলতে চান?`)) {
                let cats = getCategories();
                cats = cats.filter(c => c !== catName);
                saveCategories(cats);
                renderAdminCategoryList();
                renderCategories();
                renderVideos();
            }
        }

        function renderAdminCategoryList() {
            const listEl = document.getElementById('adminCategoryList');
            const cats = getCategories();
            listEl.innerHTML = '';
            cats.forEach(cat => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between bg-cardBg p-2.5 rounded-lg border border-slate-700 text-xs";
                item.innerHTML = `
                    <span class="font-bold text-slate-200 uppercase">${cat}</span>
                    <button onclick="deleteCategory('${cat}')" class="text-rose-400 hover:underline px-2 py-1 bg-rose-500/10 rounded">মুছুন</button>
                `;
                listEl.appendChild(item);
            });
        }

        // Ads Manager Functions
        function saveAdUnits() {
            const topBanner = document.getElementById('adTopBanner').value;
            const inlineAd = document.getElementById('adInline').value;
            const popunder = document.getElementById('adPopunder').value;

            const adsConfig = { topBanner, inlineAd, popunder };
            localStorage.setItem('videozone_ads_config', JSON.stringify(adsConfig));
            alert('বিজ্ঞাপনের কোড সফলভাবে সংরক্ষিত হয়েছে!');
            applySavedAds();
        }

        function loadSavedAdsToAdminForm() {
            let saved = localStorage.getItem('videozone_ads_config');
            if (saved) {
                let ads = JSON.parse(saved);
                document.getElementById('adTopBanner').value = ads.topBanner || '';
                document.getElementById('adInline').value = ads.inlineAd || '';
                document.getElementById('adPopunder').value = ads.popunder || '';
            }
        }

        function applySavedAds() {
            let saved = localStorage.getItem('videozone_ads_config');
            if (saved) {
                let ads = JSON.parse(saved);
                if (ads.topBanner) document.getElementById('dynamicTopBannerAd').innerHTML = ads.topBanner;
                if (ads.inlineAd) document.getElementById('dynamicInlineAd').innerHTML = ads.inlineAd;
                if (ads.popunder) {
                    let div = document.createElement('div');
                    div.innerHTML = ads.popunder;
                    document.body.appendChild(div);
                }
            }
        }

        // Video Management Functions
        function renderAdminVideoList() {
            const listEl = document.getElementById('adminVideoList');
            const videos = getVideos();
            listEl.innerHTML = '';
            if (videos.length === 0) {
                listEl.innerHTML = '<p class="text-xs text-slate-500">কোনো ভিডিও নেই।</p>';
                return;
            }
            videos.forEach(v => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between bg-cardBg p-3 rounded-xl border border-slate-700 text-xs";
                item.innerHTML = `
                    <div class="flex items-center space-x-2 truncate">
                        <span class="font-bold text-slate-200 truncate">${v.title}</span>
                        ${v.isDemo ? '<span class="bg-amber-500/20 text-amber-400 px-1.5 py-0.5 rounded text-[10px]">ডেমো</span>' : ''}
                    </div>
                    <div class="flex items-center space-x-2 flex-shrink-0">
                        <button onclick="editVideo('${v.id}')" class="text-blue-400 hover:underline px-2 py-1 bg-blue-500/10 rounded">এডিট</button>
                        <button onclick="deleteVideo('${v.id}')" class="text-rose-400 hover:underline px-2 py-1 bg-rose-500/10 rounded">মুছুন</button>
                    </div>
                `;
                listEl.appendChild(item);
            });
        }

        function handleVideoSubmit(e) {
            e.preventDefault();
            const editId = document.getElementById('editVideoId').value;
            const title = document.getElementById('vTitle').value;
            const description = document.getElementById('vDesc').value;
            const category = document.getElementById('vCategorySelect').value;
            const thumbnail = document.getElementById('vThumbnail').value;
            const driveId = document.getElementById('vDriveId').value;
            const url = document.getElementById('vUrl').value;
            const featured = document.getElementById('vFeatured').checked;
            const trending = document.getElementById('vTrending').checked;

            let videos = getVideos();
            if (videos.some(v => v.isDemo) && !editId) {
                if (confirm("ডেমো ভিডিওগুলো কি সরিয়ে দিতে চান?")) {
                    videos = videos.filter(v => !v.isDemo);
                }
            }

            if (editId) {
                videos = videos.map(v => v.id === editId ? { ...v, title, description, category, thumbnail, driveId, url, featured, trending } : v);
            } else {
                const newVideo = {
                    id: 'vid-' + Date.now(),
                    title, description, category, thumbnail,
                    duration: "1:30:00",
                    driveId, url,
                    status: 'published',
                    featured, trending,
                    isDemo: false,
                    date: new Date().toISOString().split('T')[0]
                };
                videos.unshift(newVideo);
            }

            saveVideos(videos);
            document.getElementById('videoForm').reset();
            document.getElementById('editVideoId').value = '';
            renderAdminVideoList();
            renderCategories();
            renderVideos();
            alert('ভিডিও সফলভাবে সংরক্ষণ করা হয়েছে!');
        }

        function editVideo(id) {
            const v = getVideos().find(item => item.id === id);
            if (!v) return;
            document.getElementById('editVideoId').value = v.id;
            document.getElementById('vTitle').value = v.title;
            document.getElementById('vDesc').value = v.description;
            document.getElementById('vCategorySelect').value = v.category;
            document.getElementById('vThumbnail').value = v.thumbnail;
            document.getElementById('vDriveId').value = v.driveId;
            document.getElementById('vUrl').value = v.url;
            document.getElementById('vFeatured').checked = v.featured;
            document.getElementById('vTrending').checked = v.trending;
            document.getElementById('formTitleText').innerText = "ভিডিও এডিট করুন";
        }

        function deleteVideo(id) {
            if (confirm("নিশ্চিত মুছে ফেলতে চান?")) {
                let videos = getVideos().filter(v => v.id !== id);
                saveVideos(videos);
                renderAdminVideoList();
                renderVideos();
            }
        }

        function removeAllDemoVideos() {
            if (confirm("সকল ডেমো ভিডিও মুছে ফেলতে চান?")) {
                let videos = getVideos().filter(v => !v.isDemo);
                saveVideos(videos);
                renderAdminVideoList();
                renderVideos();
            }
        }

        function resetVideoForm() {
            document.getElementById('videoForm').reset();
            document.getElementById('editVideoId').value = '';
            document.getElementById('formTitleText').innerText = "নতুন ভিডিও যোগ করুন";
        }

        window.onload = () => {
            getCategories();
            getVideos();
            renderCategories();
            renderVideos();
            applySavedAds();
        };
    </script>
</body>
</html>
